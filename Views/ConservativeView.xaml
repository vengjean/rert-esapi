<UserControl x:Class="ReRT.ConservativeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReRT"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:ConservativeViewModel}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="#0f1620" Background="#eef1f4">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ClinicalTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ROI combo that highlights amber until a choice is made -->
            <Style x:Key="RoiCombo" TargetType="ComboBox" BasedOn="{StaticResource CellCombo}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRoiMissing}" Value="True">
                        <Setter Property="Background" Value="{StaticResource WarnSoft}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource WarnLine}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Target combo highlights amber until a target structure is chosen, but only
                 when a target is required (i.e. not global evaluation) -->
            <Style x:Key="TargetCombo" TargetType="ComboBox" BasedOn="{StaticResource ModernCombo}">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding SelectedTargetRoi}" Value=""/>
                            <Condition Binding="{Binding GlobalEvaluation}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource WarnSoft}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource WarnLine}"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel x:Name="ConservativeRoot" LastChildFill="True">

        <!-- ===== Top form ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface2}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,14,16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="PLAN SUM" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Style="{StaticResource ModernCombo}" ItemsSource="{Binding PlanInputOptions}"
                              SelectedItem="{Binding SelectedInputOption, Mode=TwoWay}"
                              DisplayMemberPath="DisplayString"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="REFERRING PHYSICIAN" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding PhysicianName, Mode=TwoWay}"/>
                </StackPanel>
                <!-- Dose accumulation method (segmented toggle); bound to the host window's main VM -->
                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                    <TextBlock Text="DOSE ACCUMULATION METHOD" Style="{StaticResource FieldLabel}"/>
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineStrong}"
                            BorderThickness="1" CornerRadius="6" Height="32">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" Style="{StaticResource SegmentToggle}" Content="Rigid registration"
                                         IsChecked="{Binding DataContext.UseConservativeMethod, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"/>
                            <RadioButton Grid.Column="1" Style="{StaticResource SegmentToggle}" Content="Conservative max dose"
                                         IsChecked="{Binding DataContext.UseConservativeMethod, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="EVALUATION DATE" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EvaluationDate, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Footer ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface2}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Ok}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Busy}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Ink3}"
                               FontSize="12.5" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource LargePrimaryBtn}" Content="Export report"
                            Command="{Binding ExportCommand}"
                            IsEnabled="{Binding CanExport}"
                            ToolTip="Available after EQD2 results are calculated"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Scrollable content ===== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14,16,4">
            <StackPanel>

                <!-- Section 1: Plans -->
                <StackPanel Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Accent}">
                            <TextBlock Text="1" Foreground="White" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="PLANS" Style="{StaticResource SectionH}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource SectionMeta}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding PlanSumName, StringFormat='loaded from {0}'}"/>
                    </StackPanel>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Background="{StaticResource Surface}">
                        <StackPanel>
                            <!-- header -->
                            <Grid Background="{StaticResource Surface2}" Height="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="2.4*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="PLAN NAME" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="DATE" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="MONTHS SINCE TREATMENT" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="DELIVERED FRACTIONS" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="PRESCRIPTION DOSE" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding PlanList}" AlternationCount="99">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                                            <Grid Height="36">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46"/>
                                                    <ColumnDefinition Width="2.4*"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource PlanChip}" HorizontalAlignment="Center">
                                                    <TextBlock Foreground="{StaticResource Accent2}" FontWeight="SemiBold" FontSize="11"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource Index1Converter}}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayString}" FontWeight="SemiBold" Margin="6,0,0,0"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBox Grid.Column="2" Style="{StaticResource CellTextBox}" Margin="0,5,10,5" VerticalAlignment="Center"
                                                         Text="{Binding TreatmentDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Column="3" Style="{StaticResource CellTextBox}" Margin="0,5,10,5" VerticalAlignment="Center"
                                                         Text="{Binding MonthsSinceTreatment, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N1}"/>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBox Style="{StaticResource CellTextBox}" Width="44" Text="{Binding Fraction, Mode=TwoWay}"/>
                                                    <TextBlock Text="/" Foreground="{StaticResource Ink4}" Margin="4,0"/>
                                                    <TextBox Style="{StaticResource CellTextBox}" Width="44" Text="{Binding PlannedFraction, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="5" VerticalAlignment="Center" FontFamily="Consolas"
                                                           Text="{Binding TotalDose, StringFormat='{}{0} cGy'}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section 2: Analysis structures -->
                <StackPanel Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Accent}">
                            <TextBlock Text="2" Foreground="White" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="ANALYSIS STRUCTURES" Style="{StaticResource SectionH}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource SectionMeta}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Text="select the matching ROI per plan"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,0,0">
                            <!-- Discount-table info guide (same PNG guide as the rigid view) -->
                            <Button Name="DiscountInfoButton" Width="28" Height="28" Padding="0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding DiscountInfoCommand}"
                                    ToolTip="View the discount-table info guide"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Path Width="20" Height="20" Stretch="Uniform"
                                      Stroke="{StaticResource Accent}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Data="M 12 2 A 10 10 0 1 1 12 22 A 10 10 0 1 1 12 2 M 12 8 L 12 8.01 M 12 11 L 12 16"/>
                            </Button>
                            <!-- Centered over the view; StaysOpen=False closes it on any click elsewhere -->
                            <Popup PlacementTarget="{Binding ElementName=ConservativeRoot}"
                                   Placement="Center"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDiscountInfoOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <local:DescriptionView DataContext="{Binding DiscountInfo}"/>
                            </Popup>
                            <Button Style="{StaticResource GhostBtn}" Content="Fetch discounts" Command="{Binding FetchDiscountsCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource PrimaryBtn}" Content="+ Add structure" Command="{Binding AddStructureCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Background="{StaticResource Surface}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- header -->
                                <Grid Background="{StaticResource Surface2}" Height="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="2" Text="STRUCTURE TYPE" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="α/β" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,6,0"/>
                                    <ItemsControl Grid.Column="4" ItemsSource="{Binding PlanColumns}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="240" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,4">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource Ink4}" FontWeight="SemiBold"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Style="{StaticResource PlanChip}" Width="18" Height="18">
                                                                <TextBlock Text="{Binding Index}" Foreground="{StaticResource Accent2}" FontSize="10"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <!-- rows -->
                                <ItemsControl ItemsSource="{Binding AnalysisStructures}" AlternationCount="999">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                                                <Grid Height="36">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Style="{StaticResource DangerGhostBtn}" Content="✕"
                                                            Width="26" Height="26" HorizontalAlignment="Center" Padding="0"
                                                            Command="{Binding DataContext.RemoveStructureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <TextBlock Grid.Column="1" Foreground="{StaticResource Ink4}" FontFamily="Consolas"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource Index1Converter}}"/>
                                                    <ComboBox Grid.Column="2" Style="{StaticResource CellCombo}" Margin="2,0"
                                                              ItemsSource="{Binding DataContext.StructureTypeLabels, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding TypeLabel, Mode=TwoWay}"/>
                                                    <TextBox Grid.Column="3" Style="{StaticResource CellTextBox}" TextAlignment="Right"
                                                             Text="{Binding AlphaBetaRatio, Mode=TwoWay, StringFormat='0.0'}"/>
                                                    <ItemsControl Grid.Column="4" ItemsSource="{Binding Plans}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="240" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="158"/>
                                                                            <ColumnDefinition Width="82"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <ComboBox Grid.Column="0" Style="{StaticResource RoiCombo}" Margin="2,0"
                                                                                  ItemsSource="{Binding RoiOptions}" SelectedItem="{Binding SelectedRoi, Mode=TwoWay}"/>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                                                            <TextBox Style="{StaticResource CellTextBox}" Width="48" TextAlignment="Right"
                                                                                     Text="{Binding Discount, Mode=TwoWay, StringFormat='0'}"/>
                                                                            <TextBlock Text="%" Foreground="{StaticResource Ink4}" FontSize="11" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Margin="0,8,0,0" Padding="20,16" Background="{StaticResource Surface2}"
                            BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="6"
                            Visibility="{Binding AnalysisStructures.Count, Converter={StaticResource VisibilityInverseConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="No analysis structures yet — click &quot;Add structure&quot; to begin."
                                   Foreground="{StaticResource Ink4}" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Section 3: Results -->
                <StackPanel Margin="0,0,0,8">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Accent}">
                                <TextBlock Text="3" Foreground="White" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="EQD2 RESULTS" Style="{StaticResource SectionH}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <ToggleButton Style="{StaticResource ModeSwitch}" Tag="Post-plan" Content="Pre-plan"
                                          VerticalAlignment="Center" Margin="0,0,16,4"
                                          IsChecked="{Binding PrePlan, Mode=TwoWay}"
                                          ToolTip="Budget a new plan: enter its fractionation and an EQD2 constraint per structure; the remainder column shows the physical dose still allowed."/>
                            <!-- New plan fractionation (pre-plan only); red until the user fills it in -->
                            <StackPanel Margin="0,0,16,0"
                                        Visibility="{Binding PrePlan, Converter={StaticResource VisibilityConverter}}">
                                <TextBlock Text="NEW PLAN FX" Style="{StaticResource FieldLabel}"/>
                                <TextBox Width="60" HorizontalContentAlignment="Center"
                                         Text="{Binding PrePlanFractionation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PrePlanFractionation}" Value="">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
                                                    <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>
                            <CheckBox Content="Global (whole structure)" VerticalAlignment="Center" Margin="0,0,16,4"
                                      IsChecked="{Binding GlobalEvaluation, Mode=TwoWay}"/>
                            <StackPanel Margin="0,0,10,0"
                                        Visibility="{Binding ShowExpansion, Converter={StaticResource VisibilityConverter}}">
                                <TextBlock Text="TARGET" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource TargetCombo}" Width="160"
                                          ItemsSource="{Binding TargetRoiOptions}"
                                          SelectedItem="{Binding SelectedTargetRoi, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0"
                                        Visibility="{Binding ShowExpansion, Converter={StaticResource VisibilityConverter}}">
                                <TextBlock Text="IN-PLANE (cm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Width="74" HorizontalContentAlignment="Center"
                                         Text="{Binding InPlaneMarginCm, Mode=TwoWay, StringFormat=0.#}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0"
                                        Visibility="{Binding ShowExpansion, Converter={StaticResource VisibilityConverter}}">
                                <TextBlock Text="SUP-INF (cm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Width="74" HorizontalContentAlignment="Center"
                                         Text="{Binding SupInfMarginCm, Mode=TwoWay, StringFormat=0.#}"/>
                            </StackPanel>
                            <Button Style="{StaticResource GhostBtn}" Content="Clear" Command="{Binding ClearCommand}"
                                    Margin="0,0,8,0" VerticalAlignment="Bottom"/>
                            <Button Style="{StaticResource PrimaryBtn}" Content="Calculate" Command="{Binding CalculateCommand}"
                                    VerticalAlignment="Bottom"
                                    IsEnabled="{Binding Busy, Converter={StaticResource InverseBoolConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource SectionMeta}" Margin="34,0,0,8"
                               Text="{Binding ResultsNote}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasResults, Converter={StaticResource VisibilityConverter}}"/>

                    <Border Padding="20,16" Background="{StaticResource Surface2}"
                            BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="6"
                            Visibility="{Binding HasResults, Converter={StaticResource VisibilityInverseConverter}}">
                        <TextBlock Text="No results yet — add structures and click Calculate."
                                   Foreground="{StaticResource Ink4}" HorizontalAlignment="Center"/>
                    </Border>

                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Background="{StaticResource Surface}"
                            Visibility="{Binding HasResults, Converter={StaticResource VisibilityConverter}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- header -->
                                <Grid Background="#f5fafa" Height="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#" Style="{StaticResource FieldLabel}" Foreground="{StaticResource Accent2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="STRUCTURE" Style="{StaticResource FieldLabel}" Foreground="{StaticResource Accent2}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="α/β" Style="{StaticResource FieldLabel}" Foreground="{StaticResource Accent2}" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
                                    <Border Grid.Column="3" Background="{StaticResource AccentSoft}" BorderBrush="#b9d8d8" BorderThickness="1,0,1,0">
                                        <TextBlock Text="TOTAL D0.1cc EQD2" Style="{StaticResource FieldLabel}" Foreground="{StaticResource Accent2}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <!-- Post-plan: read-only UMichigan/SABR constraint columns -->
                                    <TextBlock Grid.Column="4" Text="UMICHIGAN" Style="{StaticResource FieldLabel}" Foreground="{StaticResource Accent2}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Visibility="{Binding PrePlan, Converter={StaticResource VisibilityInverseConverter}}"/>
                                    <TextBlock Grid.Column="5" Text="SABR" Style="{StaticResource FieldLabel}" Foreground="{StaticResource Accent2}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Visibility="{Binding PrePlan, Converter={StaticResource VisibilityInverseConverter}}"/>
                                    <!-- Pre-plan: editable EQD2 constraint + remainder (physical dose at the new fx) -->
                                    <TextBlock Grid.Column="4" Text="CONSTRAINT (EQD2)" Style="{StaticResource FieldLabel}" Foreground="{StaticResource Accent2}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Visibility="{Binding PrePlan, Converter={StaticResource VisibilityConverter}}"/>
                                    <TextBlock Grid.Column="5" Text="REMAINDER (PHYS)" Style="{StaticResource FieldLabel}" Foreground="{StaticResource Accent2}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               ToolTip="Physical dose still allowed at the new plan's fractionation, from the remaining EQD2 budget"
                                               Visibility="{Binding PrePlan, Converter={StaticResource VisibilityConverter}}"/>
                                    <ItemsControl Grid.Column="6" ItemsSource="{Binding PlanColumns}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="200" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,4">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <!-- Per-plan doses below are EQD2, not physical -->
                                                            <TextBlock DockPanel.Dock="Right" Text="EQD2" FontSize="10" Foreground="{StaticResource Accent2}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource Ink4}" FontWeight="SemiBold"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <!-- rows -->
                                <ItemsControl ItemsSource="{Binding Results}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                                                <Grid Height="40">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="190"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Index}" Foreground="{StaticResource Ink4}" FontFamily="Consolas"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding AlphaBeta}" FontFamily="Consolas" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <Border Grid.Column="3" Background="{Binding TotalBrush}" BorderBrush="#b9d8d8" BorderThickness="1,0,1,0">
                                                        <TextBlock Text="{Binding Total}" FontFamily="Consolas" FontWeight="SemiBold"
                                                                   TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    </Border>
                                                    <!-- Post-plan: read-only UMichigan/SABR constraints -->
                                                    <TextBlock Grid.Column="4" Text="{Binding MichiganConstraint}" FontFamily="Consolas" FontSize="11"
                                                               TextAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding DataContext.PrePlan, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibilityInverseConverter}}"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding SabrConstraint}" FontFamily="Consolas" FontSize="11"
                                                               TextAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding DataContext.PrePlan, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibilityInverseConverter}}"/>
                                                    <!-- Pre-plan: editable constraint ("<" kept outside the box) + hotloaded remainder -->
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Visibility="{Binding DataContext.PrePlan, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibilityConverter}}">
                                                        <TextBlock Text="&lt;" Foreground="{StaticResource Ink4}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBox Style="{StaticResource CellTextBox}" Width="76" TextAlignment="Right"
                                                                 Text="{Binding ConstraintText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Text="Gy" Foreground="{StaticResource Ink4}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="5" Background="{Binding RemainderBrush}"
                                                            Visibility="{Binding DataContext.PrePlan, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibilityConverter}}">
                                                        <TextBlock Text="{Binding Remainder}" FontFamily="Consolas" FontWeight="SemiBold"
                                                                   TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    </Border>
                                                    <ItemsControl Grid.Column="6" ItemsSource="{Binding Cells}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="200" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0">
                                                                    <TextBlock Text="{Binding Eqd2}" FontFamily="Consolas" FontWeight="SemiBold"
                                                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
