<Window x:Class="ReRT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReRT"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:dd="urn:gong-wpf-dragdrop"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:ViewModel, IsDesignTimeCreatable=True}"
        Title="Re-irradiation script — ReRT · Eclipse ESAPI"
        Height="900"
        Width="1280"
        MinWidth="1100"
        MinHeight="720"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#0f1620"
        Background="#eef1f4"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="XAMLDictionary.xaml"/>
                <ResourceDictionary Source="NativeControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ============== Clinical palette ============== -->
            <SolidColorBrush x:Key="Bg"
                             Color="#eef1f4"/>
            <SolidColorBrush x:Key="Surface"
                             Color="#ffffff"/>
            <SolidColorBrush x:Key="Surface2"
                             Color="#f6f8fa"/>
            <SolidColorBrush x:Key="Surface3"
                             Color="#eaeef2"/>
            <SolidColorBrush x:Key="Line"
                             Color="#d8dee5"/>
            <SolidColorBrush x:Key="LineStrong"
                             Color="#c2cad4"/>
            <SolidColorBrush x:Key="Ink"
                             Color="#0f1620"/>
            <SolidColorBrush x:Key="Ink2"
                             Color="#2b3540"/>
            <SolidColorBrush x:Key="Ink3"
                             Color="#5a6573"/>
            <SolidColorBrush x:Key="Ink4"
                             Color="#8a95a3"/>
            <SolidColorBrush x:Key="Accent"
                             Color="#0d8a8a"/>
            <SolidColorBrush x:Key="Accent2"
                             Color="#0a6e6e"/>
            <SolidColorBrush x:Key="AccentSoft"
                             Color="#d8eded"/>
            <SolidColorBrush x:Key="Warn"
                             Color="#b45309"/>
            <SolidColorBrush x:Key="WarnSoft"
                             Color="#fff4dc"/>
            <SolidColorBrush x:Key="WarnLine"
                             Color="#f1c581"/>
            <SolidColorBrush x:Key="WarnInk"
                             Color="#7a4d0c"/>
            <SolidColorBrush x:Key="Ok"
                             Color="#1e7d4d"/>
            <SolidColorBrush x:Key="OkSoft"
                             Color="#e2f2e8"/>
            <SolidColorBrush x:Key="OkLine"
                             Color="#b7d9c2"/>
            <SolidColorBrush x:Key="Danger"
                             Color="#b3261e"/>
            <SolidColorBrush x:Key="DangerSoft"
                             Color="#fbecec"/>
            <SolidColorBrush x:Key="DangerLine"
                             Color="#f0cccc"/>

            <!-- Converters -->
            <local:VisibilityConverter x:Key="VisibilityConverter"/>
            <local:VisibilityMultiConverter x:Key="VisibilityMultiConverter"/>
            <local:VisibilityInverseConverter x:Key="VisibilityInverseConverter"/>
            <local:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
            <local:Index1Converter x:Key="Index1Converter"/>
            <local:InverseBooleanConverter x:Key="InverseBoolConverter"/>

            <!-- ============== Mode switch ============== -->
            <!-- Left/right sliding toggle that makes the active mode obvious.
                 Tag = left (unchecked) label; Content = right (checked) label.
                 IsChecked True puts the thumb on the right and highlights Content. -->
            <Style x:Key="ModeSwitch"
                   TargetType="ToggleButton">
                <Setter Property="Foreground"
                        Value="{StaticResource Ink}"/>
                <Setter Property="Background"
                        Value="{StaticResource LineStrong}"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="FontSize"
                        Value="12.5"/>
                <Setter Property="SnapsToDevicePixels"
                        Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <StackPanel Orientation="Horizontal"
                                        Background="Transparent"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="leftLabel"
                                           Text="{TemplateBinding Tag}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           Foreground="{StaticResource Accent}"
                                           FontWeight="SemiBold"/>
                                <Border x:Name="track"
                                        Width="44"
                                        Height="22"
                                        CornerRadius="11"
                                        Background="{TemplateBinding Background}"
                                        SnapsToDevicePixels="True">
                                    <Border x:Name="thumb"
                                            Width="16"
                                            Height="16"
                                            CornerRadius="8"
                                            Background="White"
                                            HorizontalAlignment="Left"
                                            Margin="3,0,0,0"/>
                                </Border>
                                <TextBlock x:Name="rightLabel"
                                           Text="{TemplateBinding Content}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           Foreground="{StaticResource Ink4}"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked"
                                         Value="True">
                                    <Setter TargetName="track"
                                            Property="Background"
                                            Value="{StaticResource Accent}"/>
                                    <Setter TargetName="thumb"
                                            Property="HorizontalAlignment"
                                            Value="Right"/>
                                    <Setter TargetName="thumb"
                                            Property="Margin"
                                            Value="0,0,3,0"/>
                                    <Setter TargetName="leftLabel"
                                            Property="Foreground"
                                            Value="{StaticResource Ink4}"/>
                                    <Setter TargetName="leftLabel"
                                            Property="FontWeight"
                                            Value="Normal"/>
                                    <Setter TargetName="rightLabel"
                                            Property="Foreground"
                                            Value="{StaticResource Accent}"/>
                                    <Setter TargetName="rightLabel"
                                            Property="FontWeight"
                                            Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="track"
                                            Property="Opacity"
                                            Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter Property="Opacity"
                                            Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============== Field label ============== -->
            <Style x:Key="FieldLabel"
                   TargetType="TextBlock">
                <Setter Property="FontSize"
                        Value="11"/>
                <Setter Property="FontWeight"
                        Value="SemiBold"/>
                <Setter Property="Foreground"
                        Value="{StaticResource Ink3}"/>
                <Setter Property="Margin"
                        Value="0,0,0,4"/>
                <Setter Property="TextOptions.TextFormattingMode"
                        Value="Display"/>
            </Style>

            <!-- ============== Section header ============== -->
            <Style x:Key="SectionH"
                   TargetType="TextBlock">
                <Setter Property="FontSize"
                        Value="12"/>
                <Setter Property="FontWeight"
                        Value="SemiBold"/>
                <Setter Property="Foreground"
                        Value="{StaticResource Ink2}"/>
            </Style>
            <Style x:Key="SectionMeta"
                   TargetType="TextBlock">
                <Setter Property="FontSize"
                        Value="12"/>
                <Setter Property="Foreground"
                        Value="{StaticResource Ink3}"/>
            </Style>

            <!-- ============== Modern TextBox ============== -->
            <Style x:Key="ModernTextBox"
                   TargetType="TextBox">
                <Setter Property="Height"
                        Value="32"/>
                <Setter Property="Padding"
                        Value="10,0"/>
                <Setter Property="VerticalContentAlignment"
                        Value="Center"/>
                <Setter Property="Background"
                        Value="{StaticResource Surface}"/>
                <Setter Property="Foreground"
                        Value="{StaticResource Ink}"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource LineStrong}"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="SnapsToDevicePixels"
                        Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin"
                                         Value="True">
                                    <Setter TargetName="bd"
                                            Property="BorderBrush"
                                            Value="{StaticResource Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter Property="Opacity"
                                            Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============== Modern ComboBox ============== -->
            <Style x:Key="ModernComboToggle"
                   TargetType="ToggleButton">
                <Setter Property="OverridesDefaultStyle"
                        Value="True"/>
                <Setter Property="Focusable"
                        Value="False"/>
                <Setter Property="ClickMode"
                        Value="Press"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd"
                                    Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource LineStrong}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="10,0,0,0"
                                                      VerticalAlignment="Center"/>
                                    <Path Grid.Column="1"
                                          x:Name="arrow"
                                          Data="M 0 0 L 5 6 L 10 0 Z"
                                          Fill="{StaticResource Ink3}"
                                          Width="10"
                                          Height="6"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="True"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="bd"
                                            Property="BorderBrush"
                                            Value="{StaticResource Ink4}"/>
                                </Trigger>
                                <Trigger Property="IsChecked"
                                         Value="True">
                                    <Setter TargetName="bd"
                                            Property="BorderBrush"
                                            Value="{StaticResource Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter TargetName="bd"
                                            Property="Opacity"
                                            Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ControlTemplate x:Key="ModernComboTemplate"
                             TargetType="ComboBox">
                <Grid>
                    <ToggleButton Name="ToggleButton"
                                  Style="{StaticResource ModernComboToggle}"
                                  Grid.ColumnSpan="2"
                                  Focusable="False"
                                  IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                        <ContentPresenter Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"/>
                    </ToggleButton>
                    <TextBox x:Name="PART_EditableTextBox"
                             Style="{x:Null}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             Margin="10,0,22,0"
                             Focusable="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Visibility="Hidden"
                             IsReadOnly="{TemplateBinding IsReadOnly}"/>
                    <Popup Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">
                        <Border x:Name="DropDownBorder"
                                MinWidth="{TemplateBinding ActualWidth}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,4,0,0"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14"
                                                  ShadowDepth="3"
                                                  Opacity="0.18"
                                                  Color="#0f1620"/>
                            </Border.Effect>
                            <ScrollViewer SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEditable"
                             Value="True">
                        <Setter TargetName="PART_EditableTextBox"
                                Property="Visibility"
                                Value="Visible"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="ModernComboItem"
                   TargetType="ComboBoxItem">
                <Setter Property="Padding"
                        Value="10,6"/>
                <Setter Property="Foreground"
                        Value="{StaticResource Ink}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="bd"
                                    Padding="{TemplateBinding Padding}"
                                    Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted"
                                         Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="{StaticResource AccentSoft}"/>
                                </Trigger>
                                <Trigger Property="IsSelected"
                                         Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="{StaticResource Surface3}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernCombo"
                   TargetType="ComboBox">
                <Setter Property="Height"
                        Value="32"/>
                <Setter Property="Foreground"
                        Value="{StaticResource Ink}"/>
                <Setter Property="Background"
                        Value="{StaticResource Surface}"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource LineStrong}"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="SnapsToDevicePixels"
                        Value="True"/>
                <Setter Property="ItemContainerStyle"
                        Value="{StaticResource ModernComboItem}"/>
                <Setter Property="Template"
                        Value="{StaticResource ModernComboTemplate}"/>
            </Style>

            <!-- ============== Cell-level inputs (for table rows) ============== -->
            <Style x:Key="CellTextBox"
                   TargetType="TextBox">
                <Setter Property="Height"
                        Value="26"/>
                <Setter Property="Padding"
                        Value="6,0"/>
                <Setter Property="VerticalContentAlignment"
                        Value="Center"/>
                <Setter Property="Background"
                        Value="Transparent"/>
                <Setter Property="Foreground"
                        Value="{StaticResource Ink}"/>
                <Setter Property="BorderBrush"
                        Value="Transparent"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="FontFamily"
                        Value="Consolas, 'Cascadia Mono', 'Courier New'"/>
                <Setter Property="FontSize"
                        Value="12.5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="bd"
                                            Property="BorderBrush"
                                            Value="{StaticResource LineStrong}"/>
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="{StaticResource Surface}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin"
                                         Value="True">
                                    <Setter TargetName="bd"
                                            Property="BorderBrush"
                                            Value="{StaticResource Accent}"/>
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="{StaticResource Surface}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter Property="Foreground"
                                            Value="{StaticResource Ink4}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CellCombo"
                   TargetType="ComboBox"
                   BasedOn="{StaticResource ModernCombo}">
                <Setter Property="Height"
                        Value="26"/>
                <Setter Property="FontSize"
                        Value="12.5"/>
            </Style>

            <!-- ============== Buttons ============== -->
            <Style x:Key="GhostBtn"
                   TargetType="Button">
                <Setter Property="Height"
                        Value="30"/>
                <Setter Property="Padding"
                        Value="14,0"/>
                <Setter Property="Background"
                        Value="{StaticResource Surface}"/>
                <Setter Property="Foreground"
                        Value="{StaticResource Ink2}"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource LineStrong}"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="FontSize"
                        Value="12.5"/>
                <Setter Property="FontWeight"
                        Value="SemiBold"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="{StaticResource Surface3}"/>
                                    <Setter TargetName="bd"
                                            Property="BorderBrush"
                                            Value="{StaticResource Ink4}"/>
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="{StaticResource Surface2}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter Property="Opacity"
                                            Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryBtn"
                   TargetType="Button"
                   BasedOn="{StaticResource GhostBtn}">
                <Setter Property="Background"
                        Value="{StaticResource Accent}"/>
                <Setter Property="Foreground"
                        Value="White"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource Accent}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="{StaticResource Accent2}"/>
                                    <Setter TargetName="bd"
                                            Property="BorderBrush"
                                            Value="{StaticResource Accent2}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter Property="Opacity"
                                            Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LargeGhostBtn"
                   TargetType="Button"
                   BasedOn="{StaticResource GhostBtn}">
                <Setter Property="Height"
                        Value="36"/>
                <Setter Property="Padding"
                        Value="20,0"/>
                <Setter Property="FontSize"
                        Value="13"/>
            </Style>
            <Style x:Key="LargePrimaryBtn"
                   TargetType="Button"
                   BasedOn="{StaticResource PrimaryBtn}">
                <Setter Property="Height"
                        Value="36"/>
                <Setter Property="Padding"
                        Value="22,0"/>
                <Setter Property="FontSize"
                        Value="13"/>
            </Style>

            <!-- Tiny up/down stacked priority arrow buttons -->
            <Style x:Key="PrioArrowBtn"
                   TargetType="Button">
                <Setter Property="Width"
                        Value="18"/>
                <Setter Property="Height"
                        Value="13"/>
                <Setter Property="Padding"
                        Value="0"/>
                <Setter Property="Background"
                        Value="{StaticResource Surface}"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource LineStrong}"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="Foreground"
                        Value="{StaticResource Ink3}"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="{StaticResource AccentSoft}"/>
                                    <Setter TargetName="bd"
                                            Property="BorderBrush"
                                            Value="{StaticResource Accent}"/>
                                    <Setter Property="Foreground"
                                            Value="{StaticResource Accent2}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter Property="Opacity"
                                            Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Include toggle pill -->
            <Style x:Key="IncludeToggleBtn"
                   TargetType="Button">
                <Setter Property="Width"
                        Value="26"/>
                <Setter Property="Height"
                        Value="22"/>
                <Setter Property="Padding"
                        Value="0"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="Foreground"
                        Value="{StaticResource Ink3}"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="Background"
                        Value="{StaticResource Surface}"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource LineStrong}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="bd"
                                            Property="BorderBrush"
                                            Value="{StaticResource Ink4}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Plan-index chip -->
            <Style x:Key="PlanChip"
                   TargetType="Border">
                <Setter Property="Width"
                        Value="22"/>
                <Setter Property="Height"
                        Value="22"/>
                <Setter Property="CornerRadius"
                        Value="5"/>
                <Setter Property="Background"
                        Value="{StaticResource AccentSoft}"/>
                <Setter Property="VerticalAlignment"
                        Value="Center"/>
            </Style>

            <!-- ============== Plain ListView item style (no chrome) ============== -->
            <Style x:Key="FlatRowItem"
                   TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment"
                        Value="Stretch"/>
                <Setter Property="Padding"
                        Value="0"/>
                <Setter Property="Margin"
                        Value="0"/>
                <Setter Property="Height"
                        Value="36"/>
                <Setter Property="Background"
                        Value="Transparent"/>
                <Setter Property="BorderThickness"
                        Value="0"/>
                <Setter Property="SnapsToDevicePixels"
                        Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource Line}"
                                    BorderThickness="0,0,0,1"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="#080d8a8a"/>
                                </Trigger>
                                <Trigger Property="IsSelected"
                                         Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="{StaticResource AccentSoft}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Drag-aware row style preserves drag-drop while applying flat look -->
            <Style x:Key="DraggableFlatRowItem"
                   TargetType="ListViewItem"
                   BasedOn="{StaticResource FlatRowItem}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}"
                                 Value="False">
                        <Setter Property="Background"
                                Value="{StaticResource Surface2}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- ItemsControl row style for the right (discount) panel -->
            <Style x:Key="RightDiscountRow"
                   TargetType="ContentPresenter">
                <Setter Property="SnapsToDevicePixels"
                        Value="True"/>
            </Style>

            <!-- Confidence pill colors via tag -->
            <Style x:Key="ConfPill"
                   TargetType="ComboBox"
                   BasedOn="{StaticResource CellCombo}">
                <Setter Property="Height"
                        Value="24"/>
                <Setter Property="FontSize"
                        Value="12"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled"
                             Value="False">
                        <Setter Property="Opacity"
                                Value="0.55"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Status dot -->
            <Style x:Key="StatusDot"
                   TargetType="Ellipse">
                <Setter Property="Width"
                        Value="10"/>
                <Setter Property="Height"
                        Value="10"/>
                <Setter Property="Fill"
                        Value="{StaticResource Ok}"/>
            </Style>

            <!-- Segmented toggle pill (dose-accumulation method selector) -->
            <Style x:Key="SegmentToggle"
                   TargetType="RadioButton">
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="FontSize"
                        Value="12"/>
                <Setter Property="FontWeight"
                        Value="SemiBold"/>
                <Setter Property="Foreground"
                        Value="{StaticResource Ink2}"/>
                <Setter Property="HorizontalContentAlignment"
                        Value="Center"/>
                <Setter Property="VerticalContentAlignment"
                        Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd"
                                    Background="Transparent"
                                    CornerRadius="5"
                                    Margin="2"
                                    Padding="6,0"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked"
                                         Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="{StaticResource Accent}"/>
                                    <Setter Property="Foreground"
                                            Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="{StaticResource AccentSoft}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver"
                                                   Value="True"/>
                                        <Condition Property="IsChecked"
                                                   Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="{StaticResource Accent2}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- ============================================================ -->
    <!--                     OUTER LAYOUT                              -->
    <!-- ============================================================ -->
    <Grid x:Name="WindowRoot"
          Background="{StaticResource Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0 Top form -->
            <RowDefinition Height="Auto"/>
            <!-- 1 Plans section -->
            <RowDefinition Height="*"/>
            <!-- 2 Structures section -->
            <RowDefinition Height="Auto"/>
            <!-- 4 Footer -->
        </Grid.RowDefinitions>

        <!-- ====================== TOP FORM BAR ====================== -->
        <Border Grid.Row="0"
                Background="{StaticResource Surface2}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1"
                Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="0.7*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Plan sum -->
                <StackPanel Grid.Column="0"
                            Margin="0,0,14,0">
                    <TextBlock Text="PLAN SUM"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox Style="{StaticResource ModernCombo}"
                              ItemsSource="{Binding PlanInputOptions}"
                              IsEnabled="{Binding NoFatalErrorOccurred, UpdateSourceTrigger=PropertyChanged}"
                              SelectedItem="{Binding SelectedInputOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayString}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Referring physician -->
                <StackPanel Grid.Column="1"
                            Margin="0,0,14,0">
                    <TextBlock Text="REFERRING PHYSICIAN"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding PhysicianName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox"
                                   BasedOn="{StaticResource ModernTextBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PhysicianName}"
                                                 Value="">
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource Danger}"/>
                                        <Setter Property="Background"
                                                Value="{StaticResource DangerSoft}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PhysicianName}"
                                                 Value="{x:Null}">
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource Danger}"/>
                                        <Setter Property="Background"
                                                Value="{StaticResource DangerSoft}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <!-- Dose accumulation method (segmented toggle) -->
                <StackPanel Grid.Column="2"
                            Margin="0,0,14,0">
                    <TextBlock Text="DOSE ACCUMULATION METHOD"
                               Style="{StaticResource FieldLabel}"/>
                    <Border Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource LineStrong}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Height="32">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0"
                                         Style="{StaticResource SegmentToggle}"
                                         Content="Rigid registration"
                                         IsChecked="{Binding UseConservativeMethod, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"/>
                            <RadioButton Grid.Column="1"
                                         Style="{StaticResource SegmentToggle}"
                                         Content="Conservative max dose"
                                         ToolTip="Conservative maximum dose (Paradis et al.) — uses each plan's near-max instead of registration-based accumulation. Switches to the conservative view."
                                         IsChecked="{Binding UseConservativeMethod, Mode=TwoWay}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Evaluation date -->
                <StackPanel Grid.Column="3"
                            Margin="0,0,14,0">
                    <TextBlock Text="EVALUATION DATE"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding EvaluationDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Print EQD2 vs physical -->
                <StackPanel Grid.Column="4"
                            Margin="0,0,14,0">
                    <TextBlock Text="EQD2 VS. PHYS"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox Style="{StaticResource ModernCombo}"
                              ItemsSource="{Binding DoseTypes}"
                              SelectedItem="{Binding SelectedDoseType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Post vs pre-plan analysis (left/right mode switch) -->
                <StackPanel Grid.Column="5"
                            Margin="0,0,14,0">
                    <TextBlock Text="POST VS PRE-PLAN ANALYSIS"
                               Style="{StaticResource FieldLabel}"/>
                    <Border Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource LineStrong}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,0"
                            Height="32">
                        <ToggleButton Style="{StaticResource ModeSwitch}"
                                      Tag="Post"
                                      Content="Pre"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding PrePlanAnalysis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>
                </StackPanel>

                <!-- New plan fx (visible only when pre-plan) -->
                <StackPanel Grid.Column="6"
                            Visibility="{Binding PrePlanAnalysis, Converter={StaticResource VisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                    <TextBlock Text="NEW PLAN FX"
                               Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 HorizontalContentAlignment="Center"
                                 Text="{Binding NewPlanFractionation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox"
                                       BasedOn="{StaticResource ModernTextBox}">
                                    <Style.Triggers>
                                        <!-- Flag red while the fx box is empty or
                                             otherwise not a valid positive integer. -->
                                        <DataTrigger Binding="{Binding NewPlanFxValid}"
                                                     Value="False">
                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource Danger}"/>
                                            <Setter Property="Background"
                                                    Value="{StaticResource DangerSoft}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Grid.Column="1"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Ink3}"
                                   FontSize="12.5"
                                   Text="Fx"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conversion warning bar (only renders when ConversionInputWarning has text) -->
        <Border Grid.Row="0"
                VerticalAlignment="Bottom"
                Padding="16,4">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                            Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ConversionInputWarning}"
                                     Value="">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ConversionInputWarning}"
                                     Value="{x:Null}">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ConversionInputWarning, UpdateSourceTrigger=PropertyChanged}"
                       Foreground="{StaticResource Danger}"
                       FontSize="11.5"
                       FontStyle="Italic"/>
        </Border>

        <!-- ====================== PLANS SECTION ====================== -->
        <Border Grid.Row="1"
                Padding="16,14,16,8">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="PLANS"
                                   Style="{StaticResource SectionH}"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource SectionMeta}"
                                   VerticalAlignment="Center">
                            <Run Text="{Binding PlanList.Count, Mode=OneWay}"/>
                            <Run Text="included in plan sum"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryBtn}"
                                Click="FetchDiscount"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="12"
                                      Height="12"
                                      Stretch="Uniform"
                                      Stroke="White"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M 12 4 L 12 16 M 6 12 L 12 18 L 18 12 M 4 20 L 20 20"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="Fetch discounts"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostBtn}"
                                Click="ZeroDiscount">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="12"
                                      Height="12"
                                      Stretch="Uniform"
                                      Stroke="{StaticResource Ink3}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M 5 19 L 19 19 M 14 5 L 19 10 L 10 19 L 5 19 L 5 14 L 14 5 Z"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="Zero discounts"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Plans table -->
                <Border BorderBrush="{StaticResource Line}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="{StaticResource Surface}">
                    <StackPanel>
                        <!-- Table header -->
                        <Border Background="{StaticResource Surface2}"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="0,0,0,1">
                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="PLAN NAME"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="CT / PLAN DATE"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="MONTHS SINCE TREATMENT"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3"
                                           Text="DELIVERED FRACTIONS"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4"
                                           Text="TOTAL PRESCRIBED DOSE"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Table body -->
                        <ListView Name="PlanListView"
                                  ItemsSource="{Binding PlanList, UpdateSourceTrigger=PropertyChanged}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ItemContainerStyle="{StaticResource FlatRowItem}"
                                  AlternationCount="100"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  MaxHeight="220">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="14,0,0,0">
                                            <Border Style="{StaticResource PlanChip}"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListViewItem}, Converter={StaticResource Index1Converter}, FallbackValue=1}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource Accent2}"
                                                           FontFamily="Consolas, 'Cascadia Mono', 'Courier New'"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayString}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Ink}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBox Grid.Column="1"
                                                 Style="{StaticResource CellTextBox}"
                                                 Text="{Binding TreatmentDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,5,10,5"/>
                                        <TextBox Grid.Column="2"
                                                 Style="{StaticResource CellTextBox}"
                                                 Text="{Binding MonthsSinceTreatment, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N1}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,5,10,5"/>
                                        <Grid Grid.Column="3"
                                              VerticalAlignment="Center"
                                              Margin="0,5,10,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     HorizontalContentAlignment="Center"
                                                     Text="{Binding Fraction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox"
                                                           BasedOn="{StaticResource CellTextBox}">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Fraction}"
                                                                               Value="1"/>
                                                                    <Condition Binding="{Binding PlannedFraction}"
                                                                               Value="1"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background"
                                                                        Value="{StaticResource DangerSoft}"/>
                                                                <Setter Property="BorderBrush"
                                                                        Value="{StaticResource Danger}"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <TextBlock Grid.Column="1"
                                                       Text=" / "
                                                       Foreground="{StaticResource Ink4}"
                                                       VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="2"
                                                     HorizontalContentAlignment="Center"
                                                     Text="{Binding PlannedFraction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox"
                                                           BasedOn="{StaticResource CellTextBox}">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Fraction}"
                                                                               Value="1"/>
                                                                    <Condition Binding="{Binding PlannedFraction}"
                                                                               Value="1"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background"
                                                                        Value="{StaticResource DangerSoft}"/>
                                                                <Setter Property="BorderBrush"
                                                                        Value="{StaticResource Danger}"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>
                                        <Grid Grid.Column="4"
                                              VerticalAlignment="Center"
                                              Margin="0,5,14,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Style="{StaticResource CellTextBox}"
                                                     HorizontalContentAlignment="Right"
                                                     Text="{Binding TotalDose, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="cGy"
                                                       Foreground="{StaticResource Ink4}"
                                                       FontSize="11"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ====================== STRUCTURES SECTION ====================== -->
        <Border Grid.Row="2"
                Padding="16,8,16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- title bar -->
                    <RowDefinition Height="*"/>
                    <!-- structure body -->
                    <RowDefinition Height="Auto"/>
                    <!-- footer hint -->
                </Grid.RowDefinitions>

                <!-- Title row -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="STRUCTURES"
                                   Style="{StaticResource SectionH}"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource SectionMeta}"
                                   VerticalAlignment="Center">
                            <Run Text="{Binding IncludedStructureCount, Mode=OneWay}"/>
                            <Run Text="included ·"/>
                            <Run Text="{Binding ExcludedStructureCount, Mode=OneWay}"/>
                            <Run Text="excluded · use ▲▼ or drag to reorder priority"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionMeta}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource Ink3}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Text="Conversion runs on included structures only."/>
                        <Button Name="DoseSelectionInfoButton"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding DoseSelectionInfoButtonCommand}"
                                ToolTip="View source-dose help"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="Transparent"
                                            CornerRadius="14">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Background"
                                                    Value="{StaticResource AccentSoft}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Path Width="20"
                                  Height="20"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource Accent}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Data="M 12 2 A 10 10 0 1 1 12 22 A 10 10 0 1 1 12 2 M 12 8 L 12 8.01 M 12 11 L 12 16"/>
                        </Button>
                        <!-- Centered over the window (not anchored to the button); StaysOpen=False
                             closes it on any click elsewhere. -->
                        <Popup Name="DoseSelectionInfoButtonPopup"
                               PlacementTarget="{Binding ElementName=WindowRoot}"
                               Placement="Center"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               IsOpen="{Binding isDoseSelectionInfoOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <local:DescriptionView HorizontalAlignment="Stretch"
                                                   HorizontalContentAlignment="Stretch"
                                                   DataContext="{Binding DoseDescriptionViewModel}"/>
                        </Popup>
                    </StackPanel>
                </Grid>

                <!-- Body: card sized to content; horizontal scroll if wider than viewport. -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              Padding="0"
                              BorderThickness="0"
                              Focusable="False">
                    <Border HorizontalAlignment="Left"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="{StaticResource Surface}"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- HEADER (single row split into left fixed + right scrollable) -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource Surface2}"
                                    BorderBrush="{StaticResource Line}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT header (fixed widths matching row template; last column reserves vertical scrollbar) -->
                                    <Grid Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="17"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text=""/>
                                        <TextBlock Grid.Column="1"
                                                   Text="#"
                                                   Style="{StaticResource FieldLabel}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="STRUCTURE NAME"
                                                   Style="{StaticResource FieldLabel}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="TYPE"
                                                   Style="{StaticResource FieldLabel}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="α/β"
                                                   Style="{StaticResource FieldLabel}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="5"
                                                   Text="REGISTRATION CONFIDENCE"
                                                   Style="{StaticResource FieldLabel}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"/>
                                    </Grid>

                                    <!-- Discount header (sizes to content, scrolls with body) -->
                                    <ScrollViewer Grid.Column="2"
                                                  x:Name="StructureDiscountHeaderScrollViewer"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False"
                                                  Focusable="False">
                                        <ItemsControl ItemsSource="{Binding PlanDiscountHeaders, UpdateSourceTrigger=PropertyChanged}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="150"
                                                            BorderBrush="{StaticResource Line}"
                                                            BorderThickness="1,0,0,0"
                                                            Padding="10,4"
                                                            VerticalAlignment="Stretch">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Ink4}"/>
                                                            <StackPanel Orientation="Horizontal"
                                                                        Margin="0,1,0,0">
                                                                <Border Width="16"
                                                                        Height="16"
                                                                        CornerRadius="4"
                                                                        Background="{StaticResource AccentSoft}"
                                                                        Margin="0,0,6,0">
                                                                    <TextBlock Text="{Binding Index}"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource Accent2}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding PlanName}"
                                                                           FontSize="12.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource Ink}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"
                                                                           ToolTip="{Binding PlanFullName}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Pre-plan dmax constraint header (only visible when PrePlanAnalysis) -->
                                    <Border Grid.Column="1"
                                            BorderBrush="{StaticResource Line}"
                                            BorderThickness="1,0,0,0"
                                            Width="140"
                                            Visibility="{Binding PrePlanAnalysis, Converter={StaticResource VisibilityConverter}}">
                                        <TextBlock Text="DMAX CONSTRAINT"
                                                   Style="{StaticResource FieldLabel}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- BODY: LEFT (fixed) + DISCOUNT (horizontally scrollable) + PRE-PLAN (optional) -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT: structure metadata -->
                                <ListView Grid.Column="0"
                                          Name="StructureListView"
                                          ItemsSource="{Binding StructureDefinitions, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedItem="{Binding SelectedMapping, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedIndex="{Binding SelectedIndex}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="0"
                                          Margin="0"
                                          ItemContainerStyle="{StaticResource DraggableFlatRowItem}"
                                          AlternationCount="100"
                                          dd:DragDrop.IsDragSource="True"
                                          DragDrop.DragOver="DragConstraint_ListView_DragOver"
                                          DragDrop.Drop="DragConstraint_Drop"
                                          VirtualizingStackPanel.IsVirtualizing="False"
                                          ScrollViewer.CanContentScroll="False"
                                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          Width="735">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="36">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="180"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- include toggle -->
                                                <Button Grid.Column="0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding ToggleIncludeCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                               BasedOn="{StaticResource IncludeToggleBtn}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}"
                                                                             Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="{StaticResource Accent}"/>
                                                                    <Setter Property="BorderBrush"
                                                                            Value="{StaticResource Accent}"/>
                                                                    <Setter Property="Foreground"
                                                                            Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Path Stretch="Uniform"
                                                          Width="11"
                                                          Height="11"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Data"
                                                                        Value="M 5 12 L 19 12 M 12 5 L 12 19"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Include}"
                                                                                 Value="True">
                                                                        <Setter Property="Data"
                                                                                Value="M 4 12 L 10 18 L 20 6"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Button>

                                                <!-- priority cell (# + stacked arrows) -->
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}"
                                                               FontFamily="Consolas, 'Cascadia Mono', 'Courier New'"
                                                               FontSize="11"
                                                               Foreground="{StaticResource Ink3}"
                                                               VerticalAlignment="Center"
                                                               Width="20"
                                                               TextAlignment="Right"
                                                               Margin="0,0,4,0"/>
                                                    <StackPanel Orientation="Vertical"
                                                                VerticalAlignment="Center">
                                                        <Button Style="{StaticResource PrioArrowBtn}"
                                                                Margin="0,0,0,-1"
                                                                Command="{Binding DataContext.MoveStructureUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Move up">
                                                            <Path Width="9"
                                                                  Height="5"
                                                                  Stretch="Uniform"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  StrokeThickness="1.6"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  Data="M 1 5 L 5 1 L 9 5"/>
                                                        </Button>
                                                        <Button Style="{StaticResource PrioArrowBtn}"
                                                                Command="{Binding DataContext.MoveStructureDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Move down">
                                                            <Path Width="9"
                                                                  Height="5"
                                                                  Stretch="Uniform"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  StrokeThickness="1.6"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  Data="M 1 1 L 5 5 L 9 1"/>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- structure name -->
                                                <Grid Grid.Column="2"
                                                      VerticalAlignment="Center"
                                                      Margin="6,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0"
                                                           Width="14"
                                                           Height="16"
                                                           Margin="0,0,6,0"
                                                           Cursor="SizeNS"
                                                           MouseDown="DragConstraint_MouseDown"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           ToolTip="Drag to reorder">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Source"
                                                                        Value="../Resources/align.png"/>
                                                                <Setter Property="Opacity"
                                                                        Value="0.55"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver"
                                                                             Value="True">
                                                                        <Setter Property="Opacity"
                                                                                Value="1"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding Include}"
                                                                                 Value="False">
                                                                        <Setter Property="Source"
                                                                                Value="../Resources/align_grey.png"/>
                                                                        <Setter Property="Opacity"
                                                                                Value="0.45"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding StructureId}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource Ink}"/>
                                                                <Setter Property="FontWeight"
                                                                        Value="SemiBold"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Include}"
                                                                                 Value="False">
                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource Ink4}"/>
                                                                        <Setter Property="FontWeight"
                                                                                Value="Normal"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>

                                                <!-- type combo -->
                                                <ComboBox Grid.Column="3"
                                                          Style="{StaticResource CellCombo}"
                                                          Margin="6,5,6,5"
                                                          ItemsSource="{Binding DataContext.StructureLabels, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding Include, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValue="{Binding StructureLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValuePath="."
                                                          IsSynchronizedWithCurrentItem="False"
                                                          SelectionChanged="Label_SelectionChanged"/>

                                                <!-- alpha/beta -->
                                                <TextBox Grid.Column="4"
                                                         Style="{StaticResource CellTextBox}"
                                                         HorizontalContentAlignment="Right"
                                                         Margin="0,5,12,5"
                                                         Text="{Binding AlphaBetaRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding Include, UpdateSourceTrigger=PropertyChanged}"/>

                                                <!-- registration confidence -->
                                                <ComboBox Grid.Column="5"
                                                          Margin="6,5,6,5"
                                                          ItemsSource="{Binding DataContext.RegistrationConfidenceOptions, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding Include, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedItem="{Binding RegistrationConfidence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox"
                                                               BasedOn="{StaticResource CellCombo}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBody}"
                                                                             Value="True">
                                                                    <Setter Property="Opacity"
                                                                            Value="0.5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                </ComboBox>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- Pre-plan dmax constraint column (visible only when PrePlanAnalysis) -->
                                <ScrollViewer Grid.Column="1"
                                              Name="PreConstraintScrollViewer"
                                              HorizontalAlignment="Left"
                                              Width="140"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Hidden"
                                              CanContentScroll="False"
                                              BorderBrush="{StaticResource Line}"
                                              BorderThickness="1,0,0,0"
                                              Visibility="{Binding PrePlanAnalysis, Converter={StaticResource VisibilityConverter}}">
                                    <ItemsControl Name="PreConstraintColumn"
                                                  ItemsSource="{Binding StructureDefinitions, UpdateSourceTrigger=PropertyChanged}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="36"
                                                        BorderBrush="{StaticResource Line}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="8,0">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0"
                                                                 Style="{StaticResource CellTextBox}"
                                                                 HorizontalContentAlignment="Right"
                                                                 Text="{Binding PreConstraint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 IsEnabled="{Binding DataContext.PrePlanAnalysis, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="Gy EQD2"
                                                                   Foreground="{StaticResource Ink4}"
                                                                   FontSize="11"
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Discount panel (sizes to content; outer ScrollViewer handles overflow) -->
                                <Border Grid.Column="2"
                                        BorderBrush="{StaticResource Line}"
                                        BorderThickness="1,0,0,0"
                                        Background="{StaticResource Surface2}">
                                    <ScrollViewer Name="StructureDiscountScrollViewer"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  CanContentScroll="False">
                                        <ItemsControl Name="StructureDiscountList"
                                                      ItemsSource="{Binding StructureDefinitions, UpdateSourceTrigger=PropertyChanged}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="36"
                                                            BorderBrush="{StaticResource Line}"
                                                            BorderThickness="0,0,0,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background"
                                                                        Value="{StaticResource Surface2}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Include}"
                                                                                 Value="False">
                                                                        <Setter Property="Background"
                                                                                Value="{StaticResource Surface3}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <ItemsControl ItemsSource="{Binding DiscountEntries}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="150"
                                                                            BorderBrush="{StaticResource Line}"
                                                                            BorderThickness="1,0,0,0"
                                                                            Padding="10,0">
                                                                        <Grid VerticalAlignment="Center">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBox Grid.Column="0"
                                                                                     Style="{StaticResource CellTextBox}"
                                                                                     HorizontalContentAlignment="Right"
                                                                                     Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                     IsEnabled="{Binding DataContext.Include, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"/>
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="%"
                                                                                       Foreground="{StaticResource Ink4}"
                                                                                       FontSize="11"
                                                                                       Margin="6,0,0,0"
                                                                                       VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </ScrollViewer>

                <!-- Hint footer -->
                <Grid Grid.Row="2"
                      Margin="2,8,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Foreground="{StaticResource Ink4}"
                               FontSize="11.5"
                               Text="Conversion adjusts EQD2 contributions: prioritized structures resolve overlap first. Converted dose elsewhere is zero."/>
                    <TextBlock Grid.Column="1"
                               Foreground="{StaticResource Ink4}"
                               FontSize="11.5">
                        <Run Text="Scroll horizontally to access all"/>
                        <Run Text="{Binding PlanList.Count, Mode=OneWay}"/>
                        <Run Text="plans"/>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- ====================== FOOTER ====================== -->
        <Border Grid.Row="3"
                Background="{StaticResource Surface2}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status pill -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            ToolTip="{Binding StatusDetails, UpdateSourceTrigger=PropertyChanged}">
                    <Grid Width="14"
                          Height="14"
                          Margin="0,0,8,0">
                        <Ellipse Width="10"
                                 Height="10"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill"
                                            Value="{StaticResource Ok}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Working}"
                                                     Value="True">
                                            <Setter Property="Fill"
                                                    Value="{StaticResource Accent}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ErrorVisibility}"
                                                     Value="Visible">
                                            <Setter Property="Fill"
                                                    Value="{StaticResource Danger}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding WarningVisibility}"
                                                     Value="Visible">
                                            <Setter Property="Fill"
                                                    Value="{StaticResource Warn}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SuccessVisibility}"
                                                     Value="Visible">
                                            <Setter Property="Fill"
                                                    Value="{StaticResource Ok}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource Ink3}"
                               Text="{Binding StatusMessage, FallbackValue=Loading…, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Indeterminate progress bar -->
                <Border Grid.Column="1"
                        MaxWidth="360"
                        Height="4"
                        Margin="20,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource Surface3}"
                        CornerRadius="2"
                        Visibility="{Binding Working, Converter={StaticResource VisibilityConverter}, FallbackValue=Collapsed, UpdateSourceTrigger=PropertyChanged}">
                    <ProgressBar Height="4"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource Accent}"
                                 Background="Transparent"
                                 BorderThickness="0"/>
                </Border>

                <!-- Buttons: Close + Convert -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource LargeGhostBtn}"
                            Margin="0,0,8,0"
                            Click="Close_Click"
                            Content="Close"/>
                    <Button Style="{StaticResource LargePrimaryBtn}"
                            Command="{Binding ConvertCommand}"
                            IsEnabled="{Binding ConvertButtonEnabled, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding StartButtonVisibility, UpdateSourceTrigger=PropertyChanged}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="10"
                                  Height="10"
                                  Stretch="Uniform"
                                  Fill="White"
                                  Margin="0,0,8,0"
                                  Data="M 0 0 L 10 5 L 0 10 Z"/>
                            <TextBlock Text="Convert"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============== CONSERVATIVE MAX-DOSE VIEW (in-place overlay) ============== -->
        <!-- Covers the whole window when the dose-accumulation toggle is set to
             Conservative; its own "Rigid registration" button calls back out. -->
        <local:ConservativeView Grid.Row="0"
                                Grid.RowSpan="4"
                                DataContext="{Binding Conservative}"
                                Visibility="{Binding DataContext.UseConservativeMethod, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibilityConverter}}"/>
    </Grid>
</Window>
